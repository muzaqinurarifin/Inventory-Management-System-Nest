# Salin file ini menjadi .env lalu sesuaikan nilainya
# cp .env.example .env

# Port aplikasi NestJS
PORT=3000

# Koneksi database PostgreSQL
# DB_HOST=localhost karena app jalan di host, postgres di Docker
# DB_PORT=5433 (port host yang di-map ke 5432 di container)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=inventory_management
