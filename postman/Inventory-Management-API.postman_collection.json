    {
      "name": "01 - Categories",
      "item": [
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('ID kategori terbentuk (UUID)', () => pm.expect(res.id).to.match(/^[0-9a-f-]{36}$/i));",
                  "pm.test('Nama kategori sesuai', () => pm.expect(res.name).to.match(/^Elektronik Uji [0-9]+$/));",
                  "pm.test('Deskripsi tersimpan', () => pm.expect(res.description).to.eql('Kategori untuk pengujian otomatis'));",
                  "pm.collectionVariables.set('categoryId', res.id);",
                  "pm.collectionVariables.set('categoryName', res.name);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Elektronik Uji {{$timestamp}}\",\n  \"description\": \"Kategori untuk pengujian otomatis\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/categories"
          },
          "response": []
        },
        {
          "name": "Get All Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response berupa array', () => pm.expect(res).to.be.an('array'));",
                  "pm.test('Kategori baru ada di daftar', () => pm.expect(res.some((c) => c.id === pm.collectionVariables.get('categoryId'))).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories"
          },
          "response": []
        },
        {
          "name": "Get Category By ID",
